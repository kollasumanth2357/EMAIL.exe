# =================================================================
# MailPilot — Server Environment Variables Example
# =================================================================

# Server Port
PORT=5000

# Groq AI Service Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_SECONDARY_MODEL=openai/gpt-oss-120b

# Supabase PostgreSQL Database Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Google OAuth Credentials for Gmail Integration (Read-Only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/oauth/callback
